# Copiar a .env (ignorado por git) y completar. Dominio y audience son públicos (viajan en el
# bundle de la UI); el client secret del M2M no, y nunca se commitea.

# Tenant de Auth0, con barra final: es el `iss` exacto que valida cada resource server.
AUTH0_ISSUER_URI=https://<tenant>.<region>.auth0.com/
# Identifier de la API creada en Auth0 > Applications > APIs.
AUTH0_AUDIENCE=https://snippet-searcher.ingsis/

# Machine to machine: Application "Machine to Machine" autorizada sobre la API anterior.
# La usa snippet-service para llamar a permission-service y runner-service.
AUTH0_M2M_ENABLED=false
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
